		{
			"name": "Disponibilidad",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validación de Estado\r",
							"pm.test(\"Estado HTTP es 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Validación de Tiempo\r",
							"pm.test(\"El tiempo de respuesta es menor a 600ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(600);\r",
							"});\r",
							"\r",
							"// Validación de la estructura del objeto JSON\r",
							"pm.test(\"La respuesta es un objeto JSON válido y no un arreglo\", function () {\r",
							"    pm.response.to.be.json;\r",
							"    var jsonData = pm.response.json();\r",
							"    \r",
							"    // Validamos que sea un objeto {} y no un array []\r",
							"    pm.expect(jsonData).to.be.an('object');\r",
							"    pm.expect(Array.isArray(jsonData)).to.be.false;\r",
							"});\r",
							"\r",
							"// Validación robusta de los datos internos\r",
							"pm.test(\"Todas las fechas tienen estados válidos ('available' u 'occupied')\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    \r",
							"    // Extraemos todas las fechas (las llaves del objeto)\r",
							"    var fechas = Object.keys(jsonData);\r",
							"    \r",
							"    // Verificamos que el mes traiga al menos un día (que no esté vacío)\r",
							"    pm.expect(fechas.length).to.be.above(0);\r",
							"    \r",
							"    // Recorremos cada fecha para validar su contenido\r",
							"    fechas.forEach(function(fecha) {\r",
							"        let estado = jsonData[fecha];\r",
							"        \r",
							"        // Validamos que el estado de cada día sea estrictamente una de las dos opciones esperadas\r",
							"        pm.expect(estado).to.be.oneOf(['available', 'occupied']);\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
