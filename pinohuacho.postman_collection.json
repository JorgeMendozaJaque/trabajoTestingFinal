		{
			"name": "Reserva",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validación de Estado (Manejamos 200 OK o 302 si hace un redirect después del POST)\r",
							"pm.test(\"Estado HTTP es exitoso (200 o 302)\", function () {\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 302]);\r",
							"});\r",
							"\r",
							"// Validación de Tiempo\r",
							"pm.test(\"El tiempo de respuesta es menor a 1200ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1200);\r",
							"});\r",
							"\r",
							"// Validación de Tipo de Cuerpo (Aseguramos que sea HTML)\r",
							"pm.test(\"La respuesta es un documento HTML\", function () {\r",
							"    pm.response.to.have.header(\"Content-Type\");\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");\r",
							"});\r",
							"\r",
							"// Validación robusta de fechas en la vista de confirmación\r",
							"pm.test(\"La vista de confirmación contiene las fechas en formato DD/MM/YYYY\", function () {\r",
							"    const $ = cheerio.load(pm.response.text());\r",
							"    \r",
							"    // Extraemos todo el texto visible del documento HTML\r",
							"    const textoHTML = $('body').text();\r",
							"    \r",
							"    // Expresión regular exacta para DD/MM/YYYY (ej. 05/08/2026)\r",
							"    const regexFecha = /\\b\\d{2}\\/\\d{2}\\/\\d{4}\\b/g;\r",
							"    \r",
							"    // Buscamos todas las coincidencias en el texto\r",
							"    const fechasEncontradas = textoHTML.match(regexFecha);\r",
							"    \r",
							"    // Validamos que existan fechas con ese formato en el HTML\r",
							"    pm.expect(fechasEncontradas, \"No se encontraron fechas de reserva en formato DD/MM/YYYY\").to.not.be.null;\r",
							"    \r",
							"    // Debemos encontrar al menos 2 fechas (Check-in y Check-out)\r",
							"    pm.expect(fechasEncontradas.length, \"Falta el Check-in o el Check-out en el resumen\").to.be.at.least(2);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
